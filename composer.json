{
    "name": "matasarei/phptcp",
    "description": "Lightweight TCP client for PHP with pluggable socket transports, configurable timeouts, delimiter-based response framing and PSR-3 logging",
    "type": "library",
    "keywords": [
        "php",
        "tcp",
        "tcp-client",
        "socket",
        "sockets",
        "client",
        "networking",
        "stream",
        "fsockopen",
        "psr-3",
        "json-rpc"
    ],
    "homepage": "https://github.com/matasarei/phptcp",
    "license": "MIT",
    "authors": [
        {
            "name": "Yevhen Matasar",
            "email": "matasar.ei@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/matasarei/phptcp/issues",
        "source": "https://github.com/matasarei/phptcp"
    },
    "require": {
        "php": ">=7.4",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Matasar\\PhpTcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stub\\": "tests/Stub"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
